{
  "name": "{{EXT_NAME}}",
  "description": "Because why make something useful",
  "version": "{{EXT_VERSION}}",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hamsters.js"]
    }
  ],
  "permissions": ["storage", "contextMenus"],
  "key": "{{EXT_KEY}}"
}
